{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skemata.github.io/skemata/draft-01/locale",
  "title": "Skemata draft-01 locale file",
  "description": "Generated from schemas/source/draft-01.yaml. Do not edit.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "$locale",
    "texts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://skemata.github.io/skemata/draft-01/locale"
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "$locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "texts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^#"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
