Windows Registry Editor Version 5.00

; Sample data for edge-policies.skemata.yaml. The key path is shown for context only;
; Skemata schemas do not describe locations.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"HomepageLocation"="https://intranet.example.org/"
"ShowHomeButton"=dword:00000001
"RestoreOnStartup"=dword:00000004
"DiskCacheSize"=dword:06400000
"MetricsReportingEnabled"=dword:00000000
