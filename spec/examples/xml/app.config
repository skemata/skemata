<?xml version="1.0" encoding="utf-8"?>
<!-- Sample data for dotnet-app-config.skemata.yaml -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="LogLevel" value="Warning" />
    <add key="MaxConnections" value="20" />
    <add key="ReportFolder" value="%ProgramData%\Example\Reports" />
  </appSettings>
  <connectionStrings>
    <add name="Main"
         connectionString="Server=db.example.org;Database=Example;Integrated Security=true"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
